<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border#SettingsPanel RadioButton.settingsSection">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#5F536D"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="Border#SettingsPanel RadioButton.settingsSection:checked">
    <Setter Property="Background" Value="#251A35"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Border#SettingsPanel RadioButton.settingsSection:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#3D304D"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Border#SettingsPanel TextBlock.muted"><Setter Property="Foreground" Value="#5F536D"/></Style>
  <Style Selector="Border#SettingsPanel Button.primary"><Setter Property="Background" Value="#D83855"/></Style>
  <Style Selector="Border#SettingsPanel Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#C72D49"/></Style>
  <Style Selector="Window.motionEnabled Border#SettingsPanel">
    <Setter Property="Transitions"><Transitions><DoubleTransition Property="Height" Duration="0:0:0.20" Easing="ExponentialEaseOut"/></Transitions></Setter>
  </Style>
</Styles>
